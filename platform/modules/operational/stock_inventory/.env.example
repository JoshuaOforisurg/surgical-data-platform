MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=stock-inventory
MINIO_ROOT_PREFIX=stock_inventory
MINIO_ENDPOINT=http://stock-minio:9000
MINIO_SECURE=false

STOCK_PIPELINE_SOURCE_DIR=synthetic_data/generated
STOCK_PIPELINE_RUN_ID=run_docker_preview
STOCK_PIPELINE_EVENT_COUNT=250
STOCK_PIPELINE_MOVEMENT_COUNT=250
STOCK_PIPELINE_CASE_COUNT=25
STOCK_PIPELINE_SEED=42

# Optional cross-pipeline input. In cloud/scheduled runs this should point to
# the surgeon preference pipeline's latest operational Gold export mounted into
# the job container or made available by the orchestration layer.
SURGEON_PREFERENCE_GOLD_PATH=

# Use "object_store" in container/cloud dashboard deployments.
STOCK_DASHBOARD_STORAGE_MODE=object_store
