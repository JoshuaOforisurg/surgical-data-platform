# Copy this file to .env for local Docker overrides.
# Do not put real production secrets in Git.

SURGICAL_PLATFORM_ROOT=/app

# Local Docker ports
STOCK_STREAMLIT_PORT=8502
STOCK_MINIO_API_PORT=9010
STOCK_MINIO_CONSOLE_PORT=9011

# Local MinIO development credentials
MINIO_ROOT_USER=stock_inventory_minio
MINIO_ROOT_PASSWORD=local-stock-minio-password
MINIO_BUCKET=stock-inventory
MINIO_ROOT_PREFIX=stock_inventory
MINIO_SECURE=false

# Pipeline defaults
STOCK_PIPELINE_RUN_ID=run_docker_preview
STOCK_PIPELINE_SOURCE_DIR=synthetic_data/generated
STOCK_PIPELINE_EVENT_COUNT=250
STOCK_PIPELINE_MOVEMENT_COUNT=250
STOCK_PIPELINE_CASE_COUNT=25
STOCK_PIPELINE_SEED=42

# Optional cross-pipeline demand from surgeon preference Gold
SURGEON_PREFERENCE_GOLD_PATH=

# Docker dashboard reads published artifacts from MinIO.
STOCK_DASHBOARD_STORAGE_MODE=object_store
