# Copy this file to .env for local development.
# Do not put real production secrets in Git.

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=surgeon_preference_user
DB_NAME=surgeon_preference
DB_PASSWORD=

# Local Docker host port for laptop commands and GUI clients.
# Docker services override DB_PORT to 5432 because the container listens there internally.
HOST_POSTGRES_PORT=5433

# Local Storage Configuration (MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=surgeon_preference_minio
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=surgeon-preference
MINIO_LANDING_PREFIX=landing
MINIO_BRONZE_PREFIX=bronze
MINIO_SILVER_PREFIX=silver
MINIO_GOLD_PREFIX=gold
MINIO_SECURE=false

# Synthetic data defaults
SYNTHETIC_RECORD_COUNT=1000
SYNTHETIC_OUTPUT_MODE=master
SYNTHETIC_FILE_FORMATS=json,csv

# Public app controls
APP_GITHUB_PROFILE_URL=https://github.com/JoshuaOforisurg
APP_CONTACT_EMAIL=info@surgeonpreference.com
# Keep this false for a public demo unless authentication and review controls exist.
ENABLE_DRAFT_SUBMISSIONS=false
# Keep this false unless named reviewers are allowed to record approve/reject decisions.
ENABLE_DRAFT_REVIEWS=false
# Keep this false unless admin users are allowed to publish approved drafts into Gold.
ENABLE_DRAFT_PUBLISHING=false
# Local reviewer simulation for development only.
# In Azure, prefer Container Apps authentication / Microsoft Entra ID and let
# the app read verified x-ms-client-principal headers instead of app passwords.
# APP_CURRENT_USER_EMAIL=
# APP_CURRENT_USER_NAME=
# APP_EDITOR_ALLOWLIST=editor@example.com
# APP_REVIEWER_ALLOWLIST=reviewer@example.com
# APP_ADMIN_ALLOWLIST=admin@example.com

# Azure migration placeholders.
# Prefer Azure Key Vault or Container App secrets for real cloud deployments.
# When AZURE_STORAGE_CONNECTION_STRING is set, the pipeline writes landing,
# bronze, and gold objects to Azure Blob instead of local MinIO.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_CONTAINER_NAME=surgeon-preference
