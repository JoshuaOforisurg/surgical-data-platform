# Stock Inventory cloud runtime placeholders.
# Copy values into the cloud platform's secret/config system. Do not commit
# real secrets or generated .env files.

SURGICAL_PLATFORM_ROOT=/app

# Source input and cross-pipeline demand
STOCK_PIPELINE_SOURCE_DIR=synthetic_data/generated
SURGEON_PREFERENCE_GOLD_PATH=

# Azure Blob storage. Keep the connection string in the cloud secret store.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=stock-inventory

# Shared object prefix used by Azure Blob and local MinIO.
MINIO_ROOT_PREFIX=stock_inventory/prod

# Dashboard mode
STOCK_DASHBOARD_STORAGE_MODE=object_store

# Azure Database for PostgreSQL. Store the password as a cloud secret.
STOCK_DB_HOST=
STOCK_DB_PORT=5432
STOCK_DB_USER=stock_inventory_app
STOCK_DB_PASSWORD=
STOCK_DB_NAME=stock_inventory
STOCK_DB_SSLMODE=require

# Optional elevated identity used only by the migration job.
STOCK_MIGRATION_DB_HOST=
STOCK_MIGRATION_DB_PORT=5432
STOCK_MIGRATION_DB_USER=
STOCK_MIGRATION_DB_PASSWORD=
STOCK_MIGRATION_DB_NAME=stock_inventory
STOCK_MIGRATION_DB_SSLMODE=require

# Batch defaults
STOCK_PIPELINE_EVENT_COUNT=250
STOCK_PIPELINE_MOVEMENT_COUNT=250
STOCK_PIPELINE_CASE_COUNT=25
STOCK_PIPELINE_SEED=42
