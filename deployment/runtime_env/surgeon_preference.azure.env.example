# Surgeon Preference Azure runtime placeholders.
# Copy values into Container App secrets or Key Vault. Do not commit real
# secrets or generated .env files.

SURGICAL_PLATFORM_ROOT=/app

# Azure Blob storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=surgeon-preference

# Managed PostgreSQL
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=surgeon_preference

# Synthetic batch defaults
SYNTHETIC_RECORD_COUNT=1000
SYNTHETIC_OUTPUT_MODE=master
SYNTHETIC_FILE_FORMATS=json,csv

# Public app metadata
APP_ORGANISATION_ID=
APP_ORGANISATION_NAME=
APP_GITHUB_PROFILE_URL=https://github.com/JoshuaOforisurg
APP_CONTACT_EMAIL=info@surgeonpreference.com

# Workflow controls
ENABLE_DRAFT_SUBMISSIONS=false
ENABLE_DRAFT_REVIEWS=false
ENABLE_DRAFT_PUBLISHING=false

# User identity and access controls
APP_CURRENT_USER_EMAIL=
APP_CURRENT_USER_NAME=
APP_EDITOR_ALLOWLIST=
APP_REVIEWER_ALLOWLIST=
APP_ADMIN_ALLOWLIST=
